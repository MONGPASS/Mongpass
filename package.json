{
  "name": "mongpass",
  "version": "0.1.0",
  "private": false,
  "description": "Mongolian-language community and local life platform for Mongolians living in Korea",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MONGPASS/Mongpass.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/repository.test.mjs",
    "test:api": "node --test --test-timeout=180000 tests/api.e2e.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply mongpass --local",
    "db:migrate:remote": "wrangler d1 migrations apply mongpass --remote",
    "build:cloudflare": "next-on-pages",
    "deploy": "npm run build:cloudflare && wrangler pages deploy"
  },
  "dependencies": {
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "arctic": "^3.7.0",
    "lucide-react": "^0.577.0",
    "next": "14.2.15",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^4.20260507.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.88.0"
  }
}
